#[test]
fun c_div_00003() {
    set caught = ""
    sus {
        set ignored = dec_div(dec_raw(1, 0), dec_raw(0, 0), Round::HalfEven)
    } catch e: DecError {
        rewrite caught = e.code
    }
    assert_eq(caught, "ERR_DIV_BY_ZERO")
}

