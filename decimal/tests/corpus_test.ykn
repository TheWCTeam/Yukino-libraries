// ФАЙЛ СГЕНЕРИРОВАН: python gen_ykn_tests.py — руками не править.
//
// 920 тестов из корпуса vectors/ (профиль int64).
// Каждый кейс независимо проверен оракулом на Python и прогнан через
// зеркало алгоритма из src/decimal.ykn. Запуск: yukino test
load decimal: Dec, Round, DecError,
    dec_raw, dec_parse,
    dec_add, dec_sub, dec_add_fit, dec_sub_fit,
    dec_mul, dec_mul_with, dec_mul_exact,
    dec_div, dec_quantize, dec_compare

#[test]
fun c_add_00000() {
    set r = dec_add(dec_raw(134, 0), dec_raw(-242, 0))
    assert_eq(r.to_text(), "-108")
    assert_eq(r.scale_value(), 0)
}

